# Backend taban adresi (/api öneki dahil)
VITE_API_URL=http://localhost:8000/api

# true: istekler MSW ile mock'lanır, false: gerçek backend
VITE_USE_MOCK=true

# Canlı alarm WebSocket adresi (/api öneksiz). Boşsa API adresinden türetilir:
# http://localhost:8000/api -> ws://localhost:8000/ws/alarms
# VITE_WS_URL=ws://localhost:8000/ws/alarms

# Mock modda 45 sn'de bir sahte olay üreten simülatör. Kapatmak için false.
# VITE_MOCK_SIMULATOR=false
